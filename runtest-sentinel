#!/bin/sh

set -eu

if [ "$#" -ne 0 ]; then
    printf 'usage: ./runtest-sentinel\n' >&2
    exit 2
fi

if [ "${VERSAL_TCL_SKIP_BUILD:-0}" != "1" ]; then
    cargo build --bins
fi

for binary in server cli benchmark check-aof check-rdb sentinel; do
    destination="thirdparty/valkey/src/valkey-$binary"
    temporary="$destination.tmp.$$"
    cp -p "target/debug/versal-$binary" "$temporary"
    mv -f "$temporary" "$destination"
done

(
    cd thirdparty/valkey
    unset VALKEY_BIN_DIR
    python3 ../../scripts/versal-util.py tcl run -- tclsh tests/sentinel/run.tcl \
        --skip-leaks --dont-clean
)
